.DS_Store

# theme-apply's generated colour fragments.
#
# Live config directories are symlinks into this repo, so these derived files land
# next to the tracked config they belong to. They are regenerated by `theme-apply`
# from configs/linux/theme/tokyonight.conf and must never be committed.
configs/linux/hypr/colors.lua
configs/linux/hypr/colors.conf
configs/linux/hypr/hyprlock-colors.conf
configs/linux/hypr/hyprlock-background.conf
configs/linux/waybar/colors.css
configs/linux/swaync/colors.css
configs/linux/mako/colors
