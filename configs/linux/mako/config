# mako — notification daemon. Replaces SwayNotificationCenter.
# man 5 mako. Reload without restarting: makoctl reload
#
# Deliberately minimal; extend as needed. Colours live in the generated fragment,
# written by theme-apply from the master palette. The include must stay above the
# first criteria section so it lands in the global scope.
#
# NOTE: mako takes #RRGGBBAA *with* the hash; fuzzel.ini in this repo takes bare
# rrggbbaa without it. Same for fonts: Pango "Family Size" here, fontconfig
# "family:size=N" there.
include=~/.config/mako/colors

anchor=top-right
outer-margin=8
width=380
height=140
margin=6
padding=10,12
border-size=1
border-radius=10
layer=top

font=CaskaydiaCove Nerd Font Mono 10
markup=1
format=<b>%s</b>\n%b
text-alignment=left

icons=1
max-icon-size=48
icon-location=left
icon-border-radius=6

# Milliseconds here; swaync's equivalents were seconds.
default-timeout=6000
max-visible=5
history=1
max-history=20
sort=-time

on-button-left=invoke-default-action
on-button-middle=dismiss
on-button-right=dismiss-all

# ── criteria ──────────────────────────────────────────────────────────────
# Matched top to bottom; for any one option the LAST match wins, so keep the
# generic urgency blocks above the per-app ones.

[urgency=low]
default-timeout=4000

[urgency=critical]
default-timeout=0
ignore-timeout=1
border-size=2

# Do-not-disturb, toggled by `makoctl mode -t do-not-disturb` (the waybar bell's
# right-click). Critical still gets through.
[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb urgency=critical]
invisible=0

# ── per-source styling, matched on app name ───────────────────────────────
# Scripts in ~/.local/bin announce themselves with: notify-send -a <name> ...
# Accent colours for these live in the generated fragment; keep the two in sync.

# transient feedback — short, and not worth keeping in history
[app-name=wallpaper]
default-timeout=2500
ignore-timeout=1
history=0

# deploy/collect results — worth reading, so they linger
[app-name=dotfiles]
default-timeout=10000
border-size=2
group-by=app-name

# long-running jobs that report progress via the "value" hint
[app-name=backup]
default-timeout=0
group-by=app-name
