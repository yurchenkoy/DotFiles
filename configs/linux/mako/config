# mako — notifications. man 5 mako. Reload: makoctl reload
# Colours are generated by theme-apply; the include must stay above the first
# criteria section. Note mako wants #rrggbbaa and Pango "Family Size", while
# fuzzel.ini next door wants bare rrggbbaa and "family:size=N".
include=~/.config/mako/colors

anchor=top-right
outer-margin=8
width=380
height=140
margin=6
padding=10,12
border-size=1
border-radius=10
layer=top

font=CaskaydiaCove Nerd Font Mono 10
markup=1
format=<b>%s</b>\n%b
text-alignment=left

icons=1
max-icon-size=48
icon-location=left
icon-border-radius=6

# milliseconds
default-timeout=6000
max-visible=5
history=1
max-history=20
sort=-time

on-button-left=invoke-default-action
on-button-middle=dismiss
on-button-right=dismiss-all

# ── criteria — matched top to bottom, LAST match wins per option ──────────

[urgency=low]
default-timeout=4000

[urgency=critical]
default-timeout=0
ignore-timeout=1
border-size=2

# DND: `makoctl mode -t do-not-disturb` (waybar bell right-click). Critical still shows.
[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb urgency=critical]
invisible=0

# ── per-source styling: notify-send -a <name> ─────────────────────────────
# Accent colours live in the generated fragment; keep the two lists in sync.

# transient, not worth keeping
[app-name=wallpaper]
default-timeout=2500
ignore-timeout=1
history=0

# worth reading, so it lingers
[app-name=dotfiles]
default-timeout=10000
border-size=2
group-by=app-name

# long jobs; never expires
[app-name=backup]
default-timeout=0
group-by=app-name
