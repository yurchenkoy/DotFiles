// vicinae — dotfiles baseline. Imported by settings.json via its "imports" array.
//
// WHY THIS FILE EXISTS: vicinae REWRITES ~/.config/vicinae/settings.json whenever a
// setting is changed through its GUI, discarding all comments and formatting. Anything
// documented there is lost on the next GUI click. Values live here instead, where the
// GUI never touches them.
//
// PRECEDENCE: the main settings.json always wins over an imported file. That is the
// behaviour we want — this file is the documented baseline, and a deliberate GUI tweak
// overrides it. If a setting here seems to have no effect, check whether the GUI has
// written a competing value into settings.json.
{
	// --- reduced attack surface (no extensions are installed or wanted) ---
	// No system_info beacon at startup.
	"telemetry": { "system_info": false },
	// Keyboard monitoring/injection helper, needed ONLY for "paste to active window"
	// and snippet keyword expansion. Neither is used, so it stays off.
	"input_server": { "enabled": false },
	// Favicons would otherwise be fetched from a third-party service per URL.
	"favicon_service": "none",
	// NOTE: the node extension runtime is killed separately, by --no-extension-runtime
	// in configs/linux/systemd/vicinae-override.conf. It is not a settings.json option.

	// Files and directories appear directly in the root search (the Alfred behaviour).
	"search_files_in_root": true,

	// Theme is generated by scripts/theme-apply from the master palette into
	// ~/.local/share/vicinae/themes/tokyonight.toml (the DATA dir, not this one).
	"theme": {
		"dark": { "name": "tokyonight", "icon_theme": "Adwaita" },
		"light": { "name": "tokyonight", "icon_theme": "Adwaita" }
	},

	// Vicinae's built-in default is ["clipboard:history"]; empty means no Favorites row.
	"favorites": [],

	"launcher_window": {
		// Opacity and blur are Hyprland's job (windowrule in hyprland.conf), because as
		// a regular window vicinae cannot use the layer-shell blur path.
		"opacity": 1.0,
		"material": "none",
		"rounding": 14,
		"clock": { "enabled": true, "interval": 60 },
		"size": { "width": 770, "height": 480 },

		// layer_shell DELIBERATELY OFF. As a layer surface vicinae is invisible to
		// xremap: `hyprctl activewindow` keeps reporting the previously focused window
		// (e.g. ghostty), which sits in xremap's Super->Ctrl denylist, so the mac-style
		// shortcuts get suppressed inside the launcher. As a regular window it has class
		// "vicinae", xremap sees it, and Super+A / Super+C / Super+V work. It still
		// floats centred by itself, so no placement windowrule is needed.
		"layer_shell": {
			"enabled": false,
			"keyboard_interactivity": "on_demand",
			"layer": "top"
		}
	},

	"close_on_focus_loss": true,
	"pop_to_root_on_close": true,
	"escape_key_behavior": "navigate_back",
	"keybinding": "default"
}
