// vicinae main config. VICINAE REWRITES THIS FILE whenever a setting is changed in its
// GUI — comments and formatting here WILL be lost. Do not document anything in it.
// The documented baseline lives in dotfiles.json, imported below.
// After changing settings in the GUI, run ./scripts/dotfiles-collect to capture them.
{
	"$schema": "https://vicinae.com/schemas/config.json",
	"imports": ["./dotfiles.json"],
	"providers": {
		"files": {
			"entrypoints": {
				"search": {
					"enabled": false
				}
			}
		}
	}
}
