// -*- mode: jsonc -*-
{
    "include": ["~/.config/waybar/modules-custom.jsonc"],
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 6,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": [
        "tray",
        "wireplumber",
        "custom/bluetooth",
        "network",
        "custom/gpu",
        "memory",
        "custom/language",
        "custom/notifications",
        "custom/power"
    ],

    // Scroll-to-switch is overridden here because Waybar 0.15.0 still speaks the legacy
    // Hyprland dispatcher syntax ("dispatch workspace m+1"), which the Lua config manager
    // in Hyprland 0.56 rejects as a Lua syntax error — so the built-in handler is a no-op.
    // Waybar delegates to these commands whenever on-scroll-* is set (workspaces.cpp:
    // handleScroll -> AModule::handleScroll), bypassing its own broken path.
    // m±1 (not e±1) matches the built-in behaviour for "all-outputs": false — monitor-relative.
    // Clicking a workspace number is still broken and NOT fixable from config: that handler
    // is compiled in, and the module exposes no per-workspace on-click. See Waybar #5008/#5035.
    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": false,
        "format": "{name}",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m+1\" })'"
    },
    "hyprland/window": {
        "max-length": 60,
        "separate-outputs": true
    },
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "today": "<span color='#7aa2f7'><b>{}</b></span>",
                "days": "<span color='#c0caf5'>{}</span>",
                "weekdays": "<span color='#bb9af7'>{}</span>"
            }
        },
        "actions": { "on-scroll-up": "shift_up", "on-scroll-down": "shift_down" }
    },
    "tray": { "spacing": 10 },
    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "",
        "format-icons": ["", "", ""],
        "on-click": "pavucontrol",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
        "max-volume": 150
    },
    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": " {ifname}",
        "format-disconnected": "",
        "tooltip-format-wifi": "{ipaddr}/{cidr}  ({signalStrength}%)",
        "tooltip-format-ethernet": "{ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "nm-connection-editor"
    },
    "memory": { "format": " {percentage}%", "tooltip-format": "{used:0.1f}G / {total:0.1f}G" }
}
