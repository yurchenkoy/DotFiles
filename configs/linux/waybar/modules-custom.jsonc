// Custom module definitions, merged into config.jsonc via "include".
{
    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu-temp.sh",
        "return-type": "json",
        "interval": 5,
        "tooltip": true
    },
    "custom/bluetooth": {
        "exec": "~/.config/waybar/scripts/bluetooth-devices.sh",
        "return-type": "json",
        "interval": 10,
        "tooltip": true,
        "on-click": "blueman-manager"
    },
    "custom/language": {
        "exec": "~/.config/waybar/scripts/language.sh",
        "interval": 2,
        "signal": 7,
        "tooltip": "Click to switch keyboard layout",
        "on-click": "hyprctl switchxkblayout all next && pkill -RTMIN+7 waybar"
    },
    "custom/notifications": {
        "exec": "~/.config/waybar/scripts/notifications.sh",
        "return-type": "json",
        "interval": 5,
        "signal": 8,
        "format": "{}",
        "escape": false,
        "tooltip": true,
        "on-click": "makoctl restore && pkill -RTMIN+8 waybar",
        "on-click-right": "makoctl mode -t do-not-disturb && pkill -RTMIN+8 waybar",
        "on-click-middle": "makoctl dismiss -a && pkill -RTMIN+8 waybar"
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "wlogout -p layer-shell -b 2 -l $HOME/.config/wlogout/layout -C $HOME/.config/wlogout/style.css"
    }
}
