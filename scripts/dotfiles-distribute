#!/usr/bin/env zsh
# dotfiles-distribute — deploy configs from the repo to their live locations (OS-aware).
#
# Most records are LINKED: the live path becomes a symlink into the repo, so there is
# one copy of every config and a repo edit is live immediately. Records marked `copy`
# in the config map are still copied, for apps that would clobber a symlink.
#
# Re-running is a no-op. A real file or directory sitting where a symlink belongs is
# moved aside to <path>.bak rather than deleted — this runs against a live desktop.
#
# --prune deletes symlinks that point into the repo but that no record claims
# (left over when a record is removed or moved). It never touches real files.
#
# Usage: dotfiles-distribute [--dry-run] [--force] [--prune]
set -euo pipefail

if [[ -n "${DOTFILES_DIR:-}" ]]; then REPO_DIR="$DOTFILES_DIR"
else
  REPO_DIR=$(find "$HOME/Documents" -maxdepth 3 -type d -name "DotFiles" 2>/dev/null | head -1)
  [[ -z "$REPO_DIR" || ! -f "$REPO_DIR/setup.sh" ]] && { echo "  ✖  DotFiles repo not found; set \$DOTFILES_DIR."; exit 1; }
fi
REPO_DIR="${REPO_DIR:A}"
source "$REPO_DIR/scripts/lib/config-map.zsh"

DRY_RUN=0; FORCE=0; PRUNE=0
for a in "$@"; do
  case "$a" in
    --dry-run) DRY_RUN=1 ;;
    --force)   FORCE=1 ;;
    --prune)   PRUNE=1 ;;
    *) echo "  ✖  unknown flag: $a"; exit 1 ;;
  esac
done
YELLOW='\033[1;33m'; GREEN='\033[0;32m'; CYAN='\033[0;36m'; DIM='\033[2m'; RESET='\033[0m'
echo "\n${CYAN}═══ dotfiles-distribute ($(df_os)) ════════════════${RESET}"
[[ $DRY_RUN -eq 1 ]] && echo "  ${YELLOW}DRY RUN${RESET}"

typeset -A SEL=(); typeset -a LABELS=(); typeset -A LTYPE LREPO LLIVE LMODE
collect_meta(){ LABELS+=("$1"); LTYPE[$1]="$2"; LREPO[$1]="$3"; LLIVE[$1]="$4"; LMODE[$1]="$5"; }
df_each collect_meta

# ── --prune: delete symlinks into the repo that no record claims ──────────────
# Only symlinks whose target is inside the repo are candidates, so this can never
# delete a real file. Honors --dry-run (list only) and --force (no confirmation).
if [[ $PRUNE -eq 1 ]]; then
  typeset -A CLAIMED=(); for l in "${LABELS[@]}"; do CLAIMED[${LLIVE[$l]}]=1; done
  typeset -a ORPHANS=()
  echo "  ${CYAN}orphans${RESET} (symlinks into the repo with no record):"
  while IFS= read -r link; do
    [[ -n "${CLAIMED[$link]:-}" ]] && continue
    # readlink, not :A — a symlink whose target the repo no longer has is exactly
    # what this is looking for, and :A cannot resolve a broken link.
    tgt="$(readlink "$link")"
    [[ "$tgt" == "$REPO_DIR"/* ]] || continue
    [[ -e "$link" ]] || tgt="$tgt (dangling)"
    echo "  ${YELLOW}-${RESET}  $link ${DIM}→ ${tgt#$REPO_DIR/}${RESET}"
    ORPHANS+=("$link")
  done < <(
    find "$HOME" -maxdepth 1 -type l 2>/dev/null
    find "$HOME/.config" -maxdepth 2 -type l 2>/dev/null
    if [[ -d "$HOME/Library/Application Support" ]]; then
      find "$HOME/Library/Application Support" -maxdepth 2 -type l 2>/dev/null
    fi
  )
  [[ ${#ORPHANS[@]} -eq 0 ]] && { echo "  ${GREEN}✔${RESET}  none"; exit 0; }
  [[ $DRY_RUN -eq 1 ]] && exit 0
  if [[ $FORCE -eq 0 ]]; then echo -n "  Remove? (y/N) "; read -r r; [[ "$r" != [yY] ]] && { echo "  Cancelled."; exit 0; }; fi
  for link in "${ORPHANS[@]}"; do
    rm "$link"; echo "  ${GREEN}✔${RESET}  removed $link"
    # Drop the parent if that emptied it (e.g. ~/.config/environment.d/); rmdir refuses non-empty dirs.
    [[ "${link:h}" != "$HOME" && "${link:h}" != "$HOME/.config" ]] && rmdir "${link:h}" 2>/dev/null || true
  done
  exit 0
fi

# ── selection ─────────────────────────────────────────────────────────────────
if [[ $FORCE -eq 1 ]]; then for l in "${LABELS[@]}"; do SEL[$l]=1; done
elif command -v fzf &>/dev/null; then
  chosen=$(printf '%s\n' "${LABELS[@]}" | fzf --multi --height=~60% --layout=reverse --border=rounded \
    --prompt="  distribute > " --header="Tab·toggle Ctrl-A·all Enter·confirm" \
    --bind="ctrl-a:select-all,ctrl-d:deselect-all") || { echo "  Cancelled."; exit 0; }
  [[ -z "$chosen" ]] && { echo "  Nothing selected."; exit 0; }
  while IFS= read -r l; do SEL[$l]=1; done <<< "$chosen"
else for l in "${LABELS[@]}"; do SEL[$l]=1; done; fi

# ── plan ──────────────────────────────────────────────────────────────────────
typeset -A ACTION=(); work=0
for l in "${LABELS[@]}"; do
  [[ -z "${SEL[$l]:-}" ]] && continue
  src="$REPO_DIR/${LREPO[$l]}"; dst="${LLIVE[$l]}"; mode="${LMODE[$l]}"; kind="${LTYPE[$l]}"
  [[ ! -e "$src" ]] && { echo "  ${YELLOW}⚠${RESET}  not in repo: $l"; continue; }

  if [[ "$mode" == link ]]; then
    if [[ -L "$dst" && "${dst:A}" == "${src:A}" ]]; then
      ACTION[$l]=ok; echo "  ${GREEN}✔${RESET}  linked: $l"
    elif [[ -e "$dst" || -L "$dst" ]]; then
      ACTION[$l]=backup; work=1
      echo "  ${YELLOW}~${RESET}  $l ${DIM}→ back up $dst to $dst.bak, then link${RESET}"
    else
      ACTION[$l]=link; work=1; echo "  ${GREEN}+${RESET}  link: $dst"
    fi
  else
    if [[ ! -e "$dst" ]]; then ACTION[$l]=copy; work=1; echo "  ${GREEN}+${RESET}  new: $dst"
    elif [[ "$kind" == file ]]; then
      if diff -q "$src" "$dst" &>/dev/null; then ACTION[$l]=ok; echo "  ${GREEN}✔${RESET}  up to date: $l"
      else
        ACTION[$l]=copy; work=1; echo "  ${YELLOW}~${RESET}  changed: $dst"
        diff --unified=2 --color=always "$dst" "$src" | sed 's/^/      /' || true
      fi
    else
      d=$(rsync -ancO --delete --out-format="%n" "$src/" "$dst/" 2>/dev/null || true)
      if [[ -z "$d" ]]; then ACTION[$l]=ok; echo "  ${GREEN}✔${RESET}  up to date: $l"
      else
        ACTION[$l]=copy; work=1; echo "  ${YELLOW}~${RESET}  dir changed: $dst"
        echo "$d" | sed 's/^/      /'
      fi
    fi
  fi
done

[[ $work -eq 0 ]] && { echo "  ${GREEN}Nothing to do.${RESET}"; exit 0; }
[[ $DRY_RUN -eq 1 ]] && exit 0
if [[ $FORCE -eq 0 ]]; then echo -n "  Apply? (y/N) "; read -r r; [[ "$r" != [yY] ]] && { echo "  Cancelled."; exit 0; }; fi

# ── apply ─────────────────────────────────────────────────────────────────────
for l in "${LABELS[@]}"; do
  case "${ACTION[$l]:-}" in ok|"") continue ;; esac
  src="$REPO_DIR/${LREPO[$l]}"; dst="${LLIVE[$l]}"; kind="${LTYPE[$l]}"
  mkdir -p "${dst:h}"
  case "${ACTION[$l]}" in
    backup)
      bak="$dst.bak"
      [[ -e "$bak" || -L "$bak" ]] && bak="$dst.$(date +%Y%m%d%H%M%S).bak"
      mv "$dst" "$bak"
      echo "  ${YELLOW}↳${RESET}  backed up → $bak"
      ln -s "$src" "$dst"; echo "  ${GREEN}✔${RESET}  linked $dst"
      ;;
    link) ln -s "$src" "$dst"; echo "  ${GREEN}✔${RESET}  linked $dst" ;;
    copy)
      if [[ "$kind" == dir ]]; then mkdir -p "$dst"; rsync -acO --delete "$src/" "$dst/"
      else cp "$src" "$dst"; fi
      echo "  ${GREEN}✔${RESET}  copied → $dst"
      ;;
  esac
done
echo "  ${GREEN}Done.${RESET} Restart your shell or: source ~/.zshrc"
