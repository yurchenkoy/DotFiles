#!/usr/bin/env zsh
# dotfiles-collect — pull live configs back INTO the repo.
#
# Only `copy`-mode records need this: linked configs are already the repo's own files,
# so editing them live edits the repo directly and there is nothing to collect. On
# Linux that currently leaves nothing but the (mac-only) Alfred bundle, so this script
# is mostly a macOS tool plus the Brewfile refresh.
#
# Usage: dotfiles-collect [--dry-run] [--force]
set -euo pipefail

if [[ -n "${DOTFILES_DIR:-}" ]]; then REPO_DIR="$DOTFILES_DIR"
else
  REPO_DIR=$(find "$HOME/Documents" -maxdepth 3 -type d -name "DotFiles" 2>/dev/null | head -1)
  [[ -z "$REPO_DIR" || ! -f "$REPO_DIR/setup.sh" ]] && { echo "  ✖  DotFiles repo not found; set \$DOTFILES_DIR."; exit 1; }
fi
REPO_DIR="${REPO_DIR:A}"
source "$REPO_DIR/scripts/lib/config-map.zsh"

DRY_RUN=0; FORCE=0
for a in "$@"; do
  case "$a" in
    --dry-run) DRY_RUN=1 ;;
    --force)   FORCE=1 ;;
    *) echo "  ✖  unknown flag: $a"; exit 1 ;;
  esac
done
YELLOW='\033[1;33m'; GREEN='\033[0;32m'; CYAN='\033[0;36m'; DIM='\033[2m'; RESET='\033[0m'
echo "\n${CYAN}═══ dotfiles-collect ($(df_os)) ════════════════${RESET}"
[[ $DRY_RUN -eq 1 ]] && echo "  ${YELLOW}DRY RUN${RESET}"

# copy-mode records only — linked ones are the repo's files already
typeset -A SEL=(); typeset -a LABELS=(); typeset -A LTYPE LREPO LLIVE
collect_meta(){ [[ "$5" == copy ]] || return 0; LABELS+=("$1"); LTYPE[$1]="$2"; LREPO[$1]="$3"; LLIVE[$1]="$4"; }
df_each collect_meta

IS_MAC=0; [[ "$(df_os)" == mac ]] && IS_MAC=1
if [[ ${#LABELS[@]} -eq 0 && $IS_MAC -eq 0 ]]; then
  echo "  ${GREEN}Nothing to collect.${RESET} ${DIM}Every record on this OS is linked — edit the repo directly.${RESET}"
  exit 0
fi

BREW=0
if [[ $FORCE -eq 1 ]]; then
  for l in "${LABELS[@]}"; do SEL[$l]=1; done; [[ $IS_MAC -eq 1 ]] && BREW=1
elif command -v fzf &>/dev/null; then
  menu=("${LABELS[@]}"); [[ $IS_MAC -eq 1 ]] && menu+=("Brewfile")
  chosen=$(printf '%s\n' "${menu[@]}" | fzf --multi --height=~60% --layout=reverse --border=rounded \
    --prompt="  collect > " --header="Tab·toggle Ctrl-A·all Enter·confirm" \
    --bind="ctrl-a:select-all,ctrl-d:deselect-all") || { echo "  Cancelled."; exit 0; }
  [[ -z "$chosen" ]] && { echo "  Nothing selected."; exit 0; }
  while IFS= read -r l; do [[ "$l" == "Brewfile" ]] && BREW=1 || SEL[$l]=1; done <<< "$chosen"
else
  for l in "${LABELS[@]}"; do SEL[$l]=1; done; [[ $IS_MAC -eq 1 ]] && BREW=1
fi

diff_found=0
for l in "${LABELS[@]}"; do
  [[ -z "${SEL[$l]:-}" ]] && continue
  live="${LLIVE[$l]}"; dst="$REPO_DIR/${LREPO[$l]}"; kind="${LTYPE[$l]}"
  [[ ! -e "$live" ]] && { echo "  ${YELLOW}⚠${RESET}  not found live: $l"; continue; }
  if [[ ! -e "$dst" ]]; then echo "  ${GREEN}+${RESET}  new in repo: $l"; diff_found=1; continue; fi
  if [[ "$kind" == file ]]; then
    if ! diff -q "$dst" "$live" &>/dev/null; then
      echo "  ${YELLOW}~${RESET}  changed: $l"
      diff --unified=2 --color=always "$dst" "$live" | sed 's/^/      /' || true
      diff_found=1
    else echo "  ${GREEN}✔${RESET}  up to date: $l"; fi
  else
    d=$(rsync -ancO --delete --out-format="%n" "$live/" "$dst/" 2>/dev/null || true)
    if [[ -n "$d" ]]; then
      echo "  ${YELLOW}~${RESET}  dir changed: $l"
      echo "$d" | sed 's/^/      /'
      diff_found=1
    else echo "  ${GREEN}✔${RESET}  up to date: $l"; fi
  fi
done
[[ $BREW -eq 1 ]] && command -v brew &>/dev/null && { echo "  ${YELLOW}~${RESET}  Brewfile refresh"; diff_found=1; }
[[ $diff_found -eq 0 ]] && { echo "  ${GREEN}Nothing to do.${RESET}"; exit 0; }
[[ $DRY_RUN -eq 1 ]] && exit 0
if [[ $FORCE -eq 0 ]]; then echo -n "  Collect? (y/N) "; read -r r; [[ "$r" != [yY] ]] && { echo "  Cancelled."; exit 0; }; fi

for l in "${LABELS[@]}"; do
  [[ -z "${SEL[$l]:-}" ]] && continue
  live="${LLIVE[$l]}"; dst="$REPO_DIR/${LREPO[$l]}"; kind="${LTYPE[$l]}"
  [[ ! -e "$live" ]] && continue
  if [[ "$kind" == dir ]]; then mkdir -p "$dst"; rsync -acO --delete "$live/" "$dst/"
  else mkdir -p "${dst:h}"; cp "$live" "$dst"; fi
  echo "  ${GREEN}✔${RESET}  $live → $dst"
done
[[ $BREW -eq 1 ]] && command -v brew &>/dev/null && { brew bundle dump --force --file="$REPO_DIR/packages/Brewfile"; echo "  ${GREEN}✔${RESET}  Brewfile updated"; }
echo "  ${GREEN}Done.${RESET} Review: cd $REPO_DIR && git diff"
