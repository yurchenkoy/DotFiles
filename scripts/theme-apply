#!/usr/bin/env zsh
# theme-apply — regenerate every app's color fragment from the master palette.
# Idempotent. Run after editing configs/linux/theme/tokyonight.conf.
set -euo pipefail

SCRIPT_DIR="${0:A:h}"
MASTER="$SCRIPT_DIR/../configs/linux/theme/tokyonight.conf"
[[ -r "$MASTER" ]] || { print -u2 "theme-apply: master palette not found: $MASTER"; exit 1; }

# Load name=#hex pairs into an ordered assoc array.
typeset -A C
typeset -a ORDER
while IFS='=' read -r name hex; do
  [[ -z "$name" || "$name" == \#* ]] && continue
  C[$name]="$hex"        # e.g. #7aa2f7
  ORDER+=("$name")
done < "$MASTER"

gen_header="/* GENERATED by scripts/theme-apply from configs/linux/theme/tokyonight.conf — DO NOT EDIT */"
conf_header="# GENERATED by scripts/theme-apply from configs/linux/theme/tokyonight.conf — DO NOT EDIT"

# --- Hyprland: $name = 0xffRRGGBB ---
hypr_out="$HOME/.config/hypr/colors.conf"
mkdir -p "${hypr_out:h}"
{
  print -r -- "$conf_header"
  for n in $ORDER; do print -r -- "\$$n = 0xff${C[$n]#\#}"; done
} > "$hypr_out"

# --- hyprlock: $name = rgb(RRGGBB) ---
hyprlock_out="$HOME/.config/hypr/hyprlock-colors.conf"
mkdir -p "${hyprlock_out:h}"
{
  print -r -- "$conf_header"
  for n in $ORDER; do print -r -- "\$$n = rgb(${C[$n]#\#})"; done
} > "$hyprlock_out"

# --- GTK/CSS consumers: @define-color name #RRGGBB; ---
for css in "$HOME/.config/waybar/colors.css" "$HOME/.config/swaync/colors.css"; do
  mkdir -p "${css:h}"
  {
    print -r -- "$gen_header"
    for n in $ORDER; do print -r -- "@define-color $n ${C[$n]};"; done
  } > "$css"
done

# --- vicinae (.toml): themes live in the DATA dir, not the config dir, and are selected
#     by filename stem (settings.json -> theme.dark.name = "tokyonight"). ---
vicinae_out="$HOME/.local/share/vicinae/themes/tokyonight.toml"
mkdir -p "${vicinae_out:h}"
{
  print -r -- "# GENERATED by scripts/theme-apply from configs/linux/theme/tokyonight.conf — DO NOT EDIT"
  print -r -- "[meta]"
  print -r -- 'version = 1'
  print -r -- 'name = "TokyoNight Storm"'
  print -r -- 'description = "Generated from the dotfiles master palette."'
  print -r -- 'variant = "dark"'
  print -r -- ""
  print -r -- "[colors.core]"
  print -r -- "background = \"${C[bg]}\""
  print -r -- "foreground = \"${C[fg]}\""
  print -r -- "secondary_background = \"${C[bg_dark]}\""
  print -r -- "border = \"${C[comment]}\""
  print -r -- "accent = \"${C[blue]}\""
  print -r -- "accent_foreground = \"${C[bg_dark]}\""
  print -r -- ""
  print -r -- "[colors.main_window]"
  print -r -- "border = \"${C[blue]}\""
  print -r -- ""
  print -r -- "[colors.accents]"
  for n in blue green purple orange red yellow cyan; do
    print -r -- "$n = \"${C[$n]}\""
  done
  print -r -- "magenta = \"${C[purple]}\""
  print -r -- ""
  print -r -- "[colors.text]"
  print -r -- "muted = \"${C[comment]}\""
  print -r -- "placeholder = \"${C[comment]}\""
  print -r -- "danger = \"${C[red]}\""
  print -r -- "success = \"${C[green]}\""
  print -r -- "selection = { background = \"${C[blue]}\", foreground = \"${C[bg_dark]}\" }"
  print -r -- ""
  print -r -- "[colors.input]"
  print -r -- "border = \"${C[comment]}\""
  print -r -- "border_focus = \"${C[blue]}\""
  print -r -- "border_error = \"${C[red]}\""
  print -r -- ""
  print -r -- "[colors.list.item.selection]"
  print -r -- "background = \"${C[bg_high]}\""
  print -r -- "secondary_background = \"${C[bg_high]}\""
  print -r -- ""
  print -r -- "[colors.grid.item]"
  print -r -- "background = \"${C[bg_high]}\""
  print -r -- ""
  print -r -- "[colors.scrollbars]"
  print -r -- "background = \"${C[comment]}\""
  print -r -- ""
  print -r -- "[colors.loading]"
  print -r -- "bar = \"${C[blue]}\""
  print -r -- "spinner = \"${C[fg]}\""
} > "$vicinae_out"

print -r -- "theme-apply: wrote ${#ORDER} colors to hypr, hyprlock, waybar, swaync, vicinae."
