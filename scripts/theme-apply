#!/usr/bin/env zsh
# theme-apply — regenerate every app's color fragment from the master palette.
# Idempotent. Run after editing configs/linux/theme/tokyonight.conf.
set -euo pipefail

SCRIPT_DIR="${0:A:h}"
MASTER="$SCRIPT_DIR/../configs/linux/theme/tokyonight.conf"
[[ -r "$MASTER" ]] || { print -u2 "theme-apply: master palette not found: $MASTER"; exit 1; }

# Load name=#hex pairs into an ordered assoc array.
typeset -A C
typeset -a ORDER
while IFS='=' read -r name hex; do
  [[ -z "$name" || "$name" == \#* ]] && continue
  C[$name]="$hex"        # e.g. #7aa2f7
  ORDER+=("$name")
done < "$MASTER"

gen_header="/* GENERATED by scripts/theme-apply from configs/linux/theme/tokyonight.conf — DO NOT EDIT */"
conf_header="# GENERATED by scripts/theme-apply from configs/linux/theme/tokyonight.conf — DO NOT EDIT"
lua_header="-- GENERATED by scripts/theme-apply from configs/linux/theme/tokyonight.conf — DO NOT EDIT"

# --- Hyprland: a Lua module returning { name = 0xffAARRGGBB } ---
#     hyprland.lua picks this up with `local c = require("colors")`. The old
#     hyprlang `$name = ...` colors.conf is gone with the .conf config format.
hypr_out="$HOME/.config/hypr/colors.lua"
mkdir -p "${hypr_out:h}"
{
  print -r -- "$lua_header"
  print -r -- "return {"
  for n in $ORDER; do print -r -- "  $n = 0xff${C[$n]#\#},"; done
  print -r -- "}"
} > "$hypr_out"

# --- hyprlock: $name = rgb(RRGGBB) ---
hyprlock_out="$HOME/.config/hypr/hyprlock-colors.conf"
mkdir -p "${hyprlock_out:h}"
{
  print -r -- "$conf_header"
  for n in $ORDER; do print -r -- "\$$n = rgb(${C[$n]#\#})"; done
} > "$hyprlock_out"

# --- GTK/CSS consumers: @define-color name #RRGGBB; ---
css="$HOME/.config/waybar/colors.css"
mkdir -p "${css:h}"
{
  print -r -- "$gen_header"
  for n in $ORDER; do print -r -- "@define-color $n ${C[$n]};"; done
} > "$css"

# --- fuzzel: pulled in by `include=` from the tracked fuzzel.ini. Colors are RGBA
#     hex with NO leading '#', unlike every other consumer here. ---
fuzzel_out="$HOME/.config/fuzzel/colors.ini"
mkdir -p "${fuzzel_out:h}"
{
  print -r -- "$conf_header"
  print -r -- "[colors]"
  print -r -- "background=${C[bg_dark]#\#}f0"
  print -r -- "text=${C[fg]#\#}ff"
  print -r -- "prompt=${C[blue]#\#}ff"
  print -r -- "placeholder=${C[comment]#\#}ff"
  print -r -- "input=${C[fg]#\#}ff"
  print -r -- "match=${C[cyan]#\#}ff"
  print -r -- "selection=${C[bg_high]#\#}ff"
  print -r -- "selection-text=${C[fg]#\#}ff"
  print -r -- "selection-match=${C[cyan]#\#}ff"
  print -r -- "counter=${C[comment]#\#}ff"
  print -r -- "border=${C[blue]#\#}ff"
} > "$fuzzel_out"

# --- mako: pulled in by `include=` from the tracked config. mako has no named-color
#     mechanism, so every line that MENTIONS a color lives here, criteria headers
#     included — keep the criteria list in sync with configs/linux/mako/config. ---
typeset -A MAKO_ACCENTS=( wallpaper blue  dotfiles green  backup purple )
mako_out="$HOME/.config/mako/colors"
mkdir -p "${mako_out:h}"
{
  print -r -- "$conf_header"
  print -r -- "background-color=${C[bg_dark]}f2"
  print -r -- "text-color=${C[fg]}ff"
  print -r -- "border-color=${C[bg_high]}ff"
  print -r -- "progress-color=over ${C[blue]}ff"
  print -r -- ""
  print -r -- "[urgency=low]"
  print -r -- "text-color=${C[comment]}ff"
  print -r -- ""
  print -r -- "[urgency=critical]"
  print -r -- "border-color=${C[red]}ff"
  for app in wallpaper dotfiles backup; do
    print -r -- ""
    print -r -- "[app-name=$app]"
    print -r -- "border-color=${C[${MAKO_ACCENTS[$app]}]}ff"
  done
} > "$mako_out"

print -r -- "theme-apply: wrote ${#ORDER} colors to hypr, hyprlock, waybar, fuzzel, mako."
